PORT=3001
# Base local de desarrollo (sh database/bd-local.sh iniciar). En Supabase va la cadena de conexión del proyecto.
DATABASE_URL=postgres://postgres@localhost:54329/gestion_proyectos
# Orígenes del frontend separados por coma.
ORIGENES_PERMITIDOS=http://localhost:5173
# "prueba" usa la sesión simulada mientras la plataforma base no tenga inicio de sesión.
AUTENTICACION=prueba
